<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <BinRoot>$(RepoRoot)Cluiche\bin\</BinRoot>
    <LibOutDir>$(BinRoot)sharedlibs\$(Configuration)\$(Platform)\</LibOutDir>
    <OutDir>$(LibOutDir)</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)Cluiche\bin\intermediate\$(MSBuildProjectName)\$(Configuration)\$(Platform)\</IntDir>
    <TLogLocation>$(MSBuildThisFileDirectory)Cluiche\bin\log\$(MSBuildProjectName)\$(Configuration)\$(Platform)\</TLogLocation>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Sanitizer configs reuse Debug prebuilt libs (bgfx, etc. have no sanitizer variant) -->
  <PropertyGroup>
    <ExternalLibConfig>$(Configuration)</ExternalLibConfig>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug-Asan' Or '$(Configuration)'=='Debug-Ubsan'">
    <ExternalLibConfig>Debug</ExternalLibConfig>
  </PropertyGroup>

  <!-- Debug-Asan: MSVC AddressSanitizer -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug-Asan'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalOptions>/fsanitize=address %(AdditionalOptions)</AdditionalOptions>
      <!-- Prebuilt third-party static libs (libprotobufd + absl_* folded into DiaProtobuf.lib, the ASTC
           encoder folded into DiaBgfx3D.lib) are built WITHOUT ASan, so their objects carry the MSVC STL
           detect_mismatch annotate_string=0 / annotate_vector=0, while our /fsanitize=address objects carry 1.
           The linker then fails with LNK1319/LNK2038. Defining these makes every object consistent (0).
           Cost: ASan no longer checks the annotated edges of std::string / std::vector capacity;
           heap/stack overflow and use-after-free detection are unaffected. -->
      <PreprocessorDefinitions>_DISABLE_STRING_ANNOTATION;_DISABLE_VECTOR_ANNOTATION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- Debug-Ubsan: Clang-cl UndefinedBehaviorSanitizer -->
  <!-- Point ClangCL at the standalone LLVM install since VS 18 ships no bundled clang-cl -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug-Ubsan'">
    <PlatformToolset>ClangCL</PlatformToolset>
    <LLVMInstallDir>C:\Program Files\LLVM</LLVMInstallDir>
    <LLVMToolsVersion>22</LLVMToolsVersion>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug-Ubsan'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <!-- Release CRT: clang_rt.ubsan_standalone_cxx has _ITERATOR_DEBUG_LEVEL=0, not 2 -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalOptions>-fsanitize=undefined --target=x86_64-pc-windows-msvc %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
</Project>
