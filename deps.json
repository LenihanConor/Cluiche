{
  "schema": "diaenv.deps.v1",
  "deps": [
    {
      "id": "sfml",
      "version": "2.6.1",
      "url": "https://github.com/SFML/SFML/releases/download/2.6.1/SFML-2.6.1-windows-vc17-64-bit.zip",
      "mirrors": [],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "zip",
      "unzip_to": "External/SFML",
      "strip_root": true
    },
    {
      "id": "ultralight",
      "version": "1.3.0",
      "url": null,
      "mirrors": ["file:///C:/deps-cache/ultralight-1.3.0.zip"],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "zip",
      "unzip_to": "External/Ultralight",
      "strip_root": false
    },
    {
      "id": "cef",
      "version": "latest",
      "url": null,
      "mirrors": ["file:///C:/deps-cache/cef-latest.zip"],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "zip",
      "unzip_to": "External/CEF",
      "strip_root": false
    },
    {
      "id": "python311",
      "version": "3.11.9",
      "url": "https://www.python.org/ftp/python/3.11.9/python-3.11.9-embed-amd64.zip",
      "mirrors": [],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "zip",
      "unzip_to": "External/Python311",
      "strip_root": false
    },
    {
      "id": "visjs",
      "version": "latest",
      "url": null,
      "mirrors": ["file:///C:/deps-cache/visjs-latest.zip"],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "zip",
      "unzip_to": "External/VisJS",
      "strip_root": false
    },
    {
      "id": "alpinejs",
      "version": "3.14.9",
      "url": "https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js",
      "mirrors": [],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "single_file",
      "install_to": "External/Alpine/alpine.min.js"
    },
    {
      "id": "tailwindcss",
      "version": "4.2.4",
      "url": "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.2.4/dist/index.global.js",
      "mirrors": [],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "single_file",
      "install_to": "External/Tailwind/tailwind.min.js"
    },
    {
      "id": "daisyui",
      "version": "5.5.19",
      "url": "https://cdn.jsdelivr.net/npm/daisyui@5.5.19/daisyui.css",
      "mirrors": [],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "single_file",
      "install_to": "External/DaisyUI/daisyui.min.css"
    },
    {
      "id": "protobuf",
      "version": "25.6",
      "url": "https://github.com/protocolbuffers/protobuf/releases/download/v25.6/protobuf-25.6.zip",
      "mirrors": [],
      "sha256": "PLACEHOLDER_COMPUTE_AT_RUNTIME",
      "install_type": "zip",
      "unzip_to": "External/protobuf/protobuf-25.6",
      "strip_root": false
    },
    {
      "id": "imgui",
      "version": "1.90.9",
      "url": "https://github.com/ocornut/imgui/archive/refs/tags/v1.90.9.zip",
      "mirrors": [],
      "sha256": "4fa247c7abbb00fc255631479004de549b86a41f49fddd7d44cd2cf8d647c5a7",
      "install_type": "zip",
      "unzip_to": "External/imgui",
      "strip_root": true
    },
    {
      "id": "bx",
      "version": "eed706fb",
      "install_type": "build",
      "source": {
        "git": "https://github.com/bkaradzic/bx.git",
        "commit": "eed706fb272f201f628287a80da028655cab5be9"
      },
      "build": {
        "command": "echo bx is header+source only; nothing to build separately",
        "working_dir": "<clone_root>"
      },
      "stage": [
        { "from": "include", "to": "External/bx/include" },
        { "from": "src",     "to": "External/bx/src" },
        { "from": "tools/bin/windows/genie.exe", "to": "External/bx/tools/genie.exe" }
      ],
      "sentinel_inputs": [ "External/bx/tools/genie.exe" ]
    },
    {
      "id": "bimg",
      "version": "5c7eabb1",
      "install_type": "build",
      "source": {
        "git": "https://github.com/bkaradzic/bimg.git",
        "commit": "5c7eabb1d73cb0c1a3c23c0268dd70e8dca972f7"
      },
      "build": {
        "command": "echo bimg is header+source only; nothing to build separately",
        "working_dir": "<clone_root>"
      },
      "stage": [
        { "from": "include",   "to": "External/bimg/include" },
        { "from": "src",       "to": "External/bimg/src" },
        { "from": "3rdparty",  "to": "External/bimg/3rdparty" }
      ],
      "depends_on": ["bx"],
      "sentinel_inputs": []
    },
    {
      "id": "bgfx",
      "version": "7d03e160",
      "install_type": "build",
      "source": {
        "git": "https://github.com/bkaradzic/bgfx.git",
        "commit": "7d03e160fa7447660d2ff58d8cd314e9a8baae56"
      },
      "build": {
        "command": "..\\bx\\tools\\bin\\windows\\genie.exe --with-tools vs2022 && msbuild .build\\projects\\vs2022\\bgfx.sln /p:Configuration=Release /p:Platform=x64 /m:4 /p:UseMultiToolTask=false && msbuild .build\\projects\\vs2022\\bgfx.sln /p:Configuration=Debug /p:Platform=x64 /m:4 /p:UseMultiToolTask=false",
        "working_dir": "<clone_root>"
      },
      "stage": [
        { "from": "include",                                        "to": "External/bgfx/include" },
        { "from": ".build/win64_vs2022/bin/bgfxRelease.lib",        "to": "External/bgfx/lib/Release/bgfx.lib" },
        { "from": ".build/win64_vs2022/bin/bgfxDebug.lib",          "to": "External/bgfx/lib/Debug/bgfx.lib" },
        { "from": ".build/win64_vs2022/bin/shadercRelease.exe",     "to": "External/bgfx/tools/shaderc.exe" },
        { "from": "examples/common/imgui",                          "to": "External/bgfx/examples/common/imgui" },
        { "from": "examples/common/nanovg",                         "to": "External/bgfx/examples/common/nanovg" },
        { "from": "examples/common/bgfx_utils.h",                   "to": "External/bgfx/examples/common/bgfx_utils.h" },
        { "from": "3rdparty/dear-imgui",                            "to": "External/bgfx/3rdparty/dear-imgui" },
        { "from": "3rdparty/iconfontheaders",                       "to": "External/bgfx/3rdparty/iconfontheaders" }
      ],
      "depends_on": ["bx", "bimg"],
      "sentinel_inputs": [
        "External/bgfx/lib/Release/bgfx.lib",
        "External/bgfx/lib/Debug/bgfx.lib",
        "External/bgfx/tools/shaderc.exe",
        "External/bgfx/examples/common/imgui/imgui.cpp"
      ]
    }
  ]
}
