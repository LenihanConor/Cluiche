{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "version": "2.20.0",
          "rules": [
            {
              "id": "uselessCallsSubstr",
              "name": "uselessCallsSubstr",
              "shortDescription": {
                "text": "Ineffective call of function 'substr' because a prefix of the string is assigned to itself. Use replace() instead."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "invalidLifetime",
              "name": "invalidLifetime",
              "shortDescription": {
                "text": "Using object that points to local variable 'configStr' that is out of scope."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "unknownMacro",
              "name": "unknownMacro",
              "shortDescription": {
                "text": "There is an unknown macro here somewhere. Configuration is required. If DIA_SERIALIZE is a macro then please configure it."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "internalAstError",
              "name": "internalAstError",
              "shortDescription": {
                "text": "Syntax Error: AST broken, 'me' doesn't have a parent."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "preprocessorErrorDirective",
              "name": "preprocessorErrorDirective",
              "shortDescription": {
                "text": "#error \"This file was generated by a newer version of protoc which is\""
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "uninitvar",
              "name": "uninitvar",
              "shortDescription": {
                "text": "Uninitialized variable: &local"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "syntaxError",
              "name": "syntaxError",
              "shortDescription": {
                "text": "syntax error"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "shiftTooManyBitsSigned",
              "name": "shiftTooManyBitsSigned",
              "shortDescription": {
                "text": "Shifting signed 32-bit value by 31 bits is implementation-defined behaviour"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "uninitMemberVar",
              "name": "uninitMemberVar",
              "shortDescription": {
                "text": "Member variable 'UISystemImpl::mStagingBuffer' is not initialized in the constructor. Member variables of native types, pointers, or references are left uninitialized when the class is instantiated. That may cause bugs or undefined behavior."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "nullPointerOutOfMemory",
              "name": "nullPointerOutOfMemory",
              "shortDescription": {
                "text": "If memory allocation fails, then there is a possible null pointer dereference: data"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "stlFindInsert",
              "name": "stlFindInsert",
              "shortDescription": {
                "text": "Searching before insertion is not necessary. Instead of 'threadIdMap[tid]=nextIndex.Increment()-1' consider using 'threadIdMap.try_emplace(tid, nextIndex.Increment()-1);'."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "incorrectLogicOperator",
              "name": "incorrectLogicOperator",
              "shortDescription": {
                "text": "Logical disjunction always evaluates to true: b || !(b). Are these conditions necessary? Did you intend to use && instead? Are the numbers correct? Are you comparing the correct variables?"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "noCopyConstructor",
              "name": "noCopyConstructor",
              "shortDescription": {
                "text": "Struct 'WorldFixture' does not have a copy constructor which is recommended since it has dynamic memory/resource management."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "noOperatorEq",
              "name": "noOperatorEq",
              "shortDescription": {
                "text": "Struct 'WorldFixture' does not have a operator= which is recommended since it has dynamic memory/resource management."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "invalidPointerCast",
              "name": "invalidPointerCast",
              "shortDescription": {
                "text": "Casting between char * and const float * which have an incompatible binary data representation."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "ctuOneDefinitionRuleViolation",
              "name": "ctuOneDefinitionRuleViolation",
              "shortDescription": {
                "text": "The one definition rule is violated, different classes/structs have the same name 'PrimitiveCapture'"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
