{
  "format": "dia.value_schema",
  "version": 1,
  "for": "cow.worldgen.layers",
  "entries": [
    {
      "key": "relief",
      "kind": "field",
      "label": "Relief",
      "description": "Elevation shaded as terrain relief (default base layer; hillshade comes from the elevation layer).",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.terrain",
        "default_base": true,
        "elevation_layer": "elevation"
      }
    },
    {
      "key": "elevation",
      "kind": "field",
      "label": "Elevation",
      "description": "Final elevation after valley carving: ocean 0, land from the coast level up to 1, lakes at their surface.",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.terrain"
      }
    },
    {
      "key": "latitude",
      "kind": "field",
      "label": "Latitude",
      "description": "Normalised distance from the equator: 0 at the equator, 1 at the pole.",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.blue"
      }
    },
    {
      "key": "coastDistance",
      "kind": "field",
      "label": "Coast distance",
      "description": "Hex steps from the nearest coast cell.",
      "unit": "cells",
      "type": "float",
      "min": 0,
      "max": 20,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.green"
      }
    },
    {
      "key": "landPotential",
      "kind": "field",
      "label": "Land potential",
      "description": "Landmass stage land potential before thresholding (ocean cells may hold -infinity, shown at the low end).",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.green"
      }
    },
    {
      "key": "islandPotential",
      "kind": "field",
      "label": "Island potential",
      "description": "Landmass stage island-blob potential.",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.green"
      }
    },
    {
      "key": "landmass",
      "kind": "field",
      "label": "Landmass id",
      "description": "Landmass id per cell: 0 is ocean, 1.. one per landmass (ids saturate at 255, so this is a ramp, not a palette).",
      "type": "float",
      "min": 0,
      "max": 16,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.purple"
      }
    },
    {
      "key": "ridgeMask",
      "kind": "field",
      "label": "Ridge mask",
      "description": "Mountain ridge strength produced by the Mountains stage.",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.heat"
      }
    },
    {
      "key": "barrierMask",
      "kind": "field",
      "label": "Barrier mask",
      "description": "Barrier (plateau or volcanic chain) strength.",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.heat"
      }
    },
    {
      "key": "elevationRaw",
      "kind": "field",
      "label": "Raw elevation",
      "description": "Elevation before drainage fill and valley carving.",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.terrain"
      }
    },
    {
      "key": "filledElevation",
      "kind": "field",
      "label": "Filled elevation",
      "description": "Elevation after depression filling (drainage).",
      "type": "float",
      "min": 0,
      "max": 1,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.terrain"
      }
    },
    {
      "key": "basinDepth",
      "kind": "field",
      "label": "Basin depth",
      "description": "Depth of each depression removed by the fill.",
      "type": "float",
      "min": 0,
      "max": 0.05,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.blue"
      }
    },
    {
      "key": "flowAccumulation",
      "kind": "field",
      "label": "Flow accumulation",
      "description": "Number of upstream cells draining through each cell.",
