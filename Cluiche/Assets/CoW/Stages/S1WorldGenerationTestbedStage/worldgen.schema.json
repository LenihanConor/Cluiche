      "type": "float",
      "min": 0,
      "max": 200,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.blue"
      }
    },
    {
      "key": "valleyCarve",
      "kind": "field",
      "label": "Valley carve",
      "description": "Elevation removed by river valley carving.",
