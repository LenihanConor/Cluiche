      "min": 0,
      "max": 0.04,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.purple"
      }
    },
    {
      "key": "slope",
      "kind": "field",
      "label": "Slope",
      "description": "Steepest elevation drop to a neighbour, used to classify cliffs.",
      "type": "float",
      "min": 0,
      "max": 0.5,
      "ui": {
        "inset": 0.05,
        "backdrop": "#101418",
        "ramp": "sequential.grey"
      }
    },
    {
      "key": "oceanDepth",
      "kind": "field",
      "label": "Ocean depth",
      "description": "Depth below the coast level for ocean cells.",
