{
    "version": 3,
    "streams": [
        { "id": "DomainStateSnapshot0", "kind": "FrameStream", "payload_type": "ViewerStateSlot", "from": "SimPU", "to": "MainPU", "multi_writer": false },
        { "id": "DomainStateDemand0", "kind": "EventStream", "payload_type": "ViewerStateDemandEvent", "overflow": "drop-oldest", "capacity": 8, "from": "MainPU", "to": "SimPU" },
        { "id": "DomainStateChannel0", "kind": "ServiceStream", "payload_type": "DomainStateChannel", "from": "MainPU" },
        { "id": "DomainStateSnapshot1", "kind": "FrameStream", "payload_type": "ViewerStateSlot", "from": "SimPU", "to": "MainPU", "multi_writer": false },
        { "id": "DomainStateDemand1", "kind": "EventStream", "payload_type": "ViewerStateDemandEvent", "overflow": "drop-oldest", "capacity": 8, "from": "MainPU", "to": "SimPU" },
        { "id": "DomainStateChannel1", "kind": "ServiceStream", "payload_type": "DomainStateChannel", "from": "MainPU" },
        { "id": "DomainStateSnapshot2", "kind": "FrameStream", "payload_type": "ViewerStateSlot", "from": "SimPU", "to": "MainPU", "multi_writer": false },
        { "id": "DomainStateDemand2", "kind": "EventStream", "payload_type": "ViewerStateDemandEvent", "overflow": "drop-oldest", "capacity": 8, "from": "MainPU", "to": "SimPU" },
        { "id": "DomainStateChannel2", "kind": "ServiceStream", "payload_type": "DomainStateChannel", "from": "MainPU" },
        { "id": "DomainStateSnapshot3", "kind": "FrameStream", "payload_type": "ViewerStateSlot", "from": "SimPU", "to": "MainPU", "multi_writer": false },
        { "id": "DomainStateDemand3", "kind": "EventStream", "payload_type": "ViewerStateDemandEvent", "overflow": "drop-oldest", "capacity": 8, "from": "MainPU", "to": "SimPU" },
        { "id": "DomainStateChannel3", "kind": "ServiceStream", "payload_type": "DomainStateChannel", "from": "MainPU" }
    ],
    "processing_units": [
        {
            "instance_id": "MainPU",
            "frequency_hz": 30,
            "dedicated_thread": false,
            "modules": [
                {
                    "instance_id": "DomainStateBridgeModule",
                    "type_id": "DomainStateBridgeModule",
                    "stages": [
                        "S1WorldGenerationTestbedStage"
                    ],
                    "dependencies": [],
                    "channels": [
                        { "id": "DomainStateSnapshot0", "role": "reads" },
                        { "id": "DomainStateDemand0", "role": "writes" },
                        { "id": "DomainStateChannel0", "role": "provides" },
                        { "id": "DomainStateSnapshot1", "role": "reads" },
                        { "id": "DomainStateDemand1", "role": "writes" },
                        { "id": "DomainStateChannel1", "role": "provides" },
                        { "id": "DomainStateSnapshot2", "role": "reads" },
                        { "id": "DomainStateDemand2", "role": "writes" },
                        { "id": "DomainStateChannel2", "role": "provides" },
                        { "id": "DomainStateSnapshot3", "role": "reads" },
                        { "id": "DomainStateDemand3", "role": "writes" },
                        { "id": "DomainStateChannel3", "role": "provides" }
                    ]
                }
            ]
        },
        {
            "instance_id": "SimPU",
            "frequency_hz": 30,
            "dedicated_thread": true,
            "modules": [
                {
                    "instance_id": "WorldGenerationModule",
                    "type_id": "WorldGenerationModule",
                    "stages": [
                        "S1WorldGenerationTestbedStage"
                    ],
                    "dependencies": [
                        "MessageBusHostModule",
                        "RandomStreamModule",
                        "SimQueryHostModule"
                    ],
                    "config": {
                        "presets_dir": "assets/global/misc",
                        "out_presets_dir": "Cluiche/out/CoW/presets"
                    },
                    "channels": []
                },
                {
                    "instance_id": "DomainStateRelayModule",
                    "type_id": "DomainStateRelayModule",
                    "stages": [
                        "S1WorldGenerationTestbedStage"
                    ],
                    "dependencies": [],
                    "channels": [
                        { "id": "DomainStateSnapshot0", "role": "writes" },
                        { "id": "DomainStateDemand0", "role": "reads" },
                        { "id": "DomainStateChannel0", "role": "consumes" },
                        { "id": "DomainStateSnapshot1", "role": "writes" },
                        { "id": "DomainStateDemand1", "role": "reads" },
                        { "id": "DomainStateChannel1", "role": "consumes" },
                        { "id": "DomainStateSnapshot2", "role": "writes" },
                        { "id": "DomainStateDemand2", "role": "reads" },
                        { "id": "DomainStateChannel2", "role": "consumes" },
                        { "id": "DomainStateSnapshot3", "role": "writes" },
                        { "id": "DomainStateDemand3", "role": "reads" },
                        { "id": "DomainStateChannel3", "role": "consumes" }
                    ]
                },
                {
                    "instance_id": "S1WorldGenerationTestbedStageModule",
                    "type_id": "S1WorldGenerationTestbedStageModule",
                    "stages": [
                        "S1WorldGenerationTestbedStage"
                    ],
                    "dependencies": [
                        "InputStreamModule",
                        "VisualDebuggerModule",
                        "DomainStateRelayModule",
                        "WorldGenerationModule"
                    ],
                    "channels": [
                        {
                            "id": "AssetLoadStatus",
                            "role": "consumes"
                        },
                        {
                            "id": "AssetRuntimeService",
                            "role": "consumes"
                        },
                        {
                            "id": "AutomationService",
                            "role": "consumes"
                        }
                    ]
                }
            ]
        }
    ]
}