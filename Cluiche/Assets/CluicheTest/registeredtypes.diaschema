  "game": "cluichetest",
  "modules": [
    {
      "allowed_pus": "render",
      "description": "Displays the CluicheTest boot menu for selecting which test stage to run.",
      "type_id": "BootMenuModule"
    },
    {
      "allowed_pus": "main",
      "description": "Drives CluicheTest top-level state: stage selection, transitions, and test lifecycle.",
      "type_id": "TestMainStateProducerModule"
    },
    {
      "allowed_pus": "sim",
      "description": "Test stage exercising 2D rigid-body physics: polygon ground, falling circles, a thrown body, a distance-joint pendulum, a trigger volume, collision events and a raycast.",
      "type_id": "RigidBody2DTestModule"
    },
    {
      "allowed_pus": "sim",
      "description": "Test stage for the asset runtime: hot-reload, streaming, and reference-counted asset lifecycle.",
