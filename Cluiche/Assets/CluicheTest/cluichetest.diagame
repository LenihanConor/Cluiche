{
    "config": {
        "name": "CluicheTest",
        "build": "dev-0.1",
        "window": {
            "title": "CluicheTest - e2e tests",
            "width_pct": 80,
            "height_pct": 80
        },
        "asset_catalogue": "assets.catalogue.json",
        "observation": "cluichetest.diaobservation",
        "path_aliases": {
            "root": ".",
            "ui_common": "./global/Presentation/UI"
        },
        "ultralight": {
            "resource_path_prefix": "global/Misc/Resources/"
        }
    },
    "imports": [
        {
            "path": "global/misc/ApplicationFlow/cluiche_main.diaapp",
            "type": "manifest"
        },
        {
            "path": "stages/DummyStage/dummy_stage.diastage",
            "type": "stage"
        },
        {
            "path": "stages/RigidBody2DTestStage/rigidbody2d_stage.diastage",
            "type": "stage"
        },
        {
            "path": "stages/AssetRuntimeTestStage/asset_runtime_stage.diastage",
            "type": "stage"
        },
        {
            "path": "stages/Geometry2DTestStage/geometry2d_test_stage.diastage",
            "type": "stage"
        },
        {
            "path": "stages/UIUltralightTestStage/ui_ultralight_test_stage.diastage",
            "type": "stage"
        },
        {
            "path": "stages/EntityTestStage/entity_test_stage.diastage",
            "type": "stage"
        },
        {
            "path": "stages/SoftBody2DTestStage/softbody2d_test_stage.diastage",
            "type": "stage"
        }
    ],
    "name": "CluicheTest",
    "version": "0.1"
}