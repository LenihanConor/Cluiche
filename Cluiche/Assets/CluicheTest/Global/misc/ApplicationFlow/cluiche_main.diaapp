                    ],
                    "channels": [
                        {
                            "id": "SimDebug",
                            "role": "writes"
                        },
                        {
                            "id": "DebugLayerManager",
                            "role": "provides"
                        },
                        {
                            "id": "DomainRegistry",
                            "role": "writes"
                        },
                        {
                            "id": "DebugPanelCommand",
                            "role": "reads"
