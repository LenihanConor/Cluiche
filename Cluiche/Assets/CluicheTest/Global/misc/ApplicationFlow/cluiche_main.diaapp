        }
    ],
    "initial_stage": "Boot",
    "streams": [
        {
            "id": "MainToSim",
            "kind": "EventStream",
            "payload_type": "MainToSimEvent",
            "overflow": "drop-oldest",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "SimToRender",
            "kind": "FrameStream",
            "payload_type": "FrameData",
            "from": "SimPU",
            "to": "RenderPU",
            "multi_writer": false
        },
        {
            "id": "SimScene",
            "kind": "FrameStream",
            "payload_type": "FrameData",
            "from": "SimPU",
            "to": "SimPU",
            "multi_writer": true
        },
        {
            "id": "SimDebug",
            "kind": "FrameStream",
            "payload_type": "FrameData",
            "from": "SimPU",
            "to": "SimPU",
            "multi_writer": false
        },
        {
            "id": "SimToRender3D",
            "kind": "FrameStream",
            "payload_type": "FrameData3D",
            "from": "SimPU",
            "to": "RenderPU",
            "multi_writer": true
        },
        {
            "id": "SimToMain",
            "kind": "EventStream",
            "payload_type": "SimToMainEvent",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "UIToSim",
            "kind": "FrameStream",
            "payload_type": "UIDataBuffer",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "MainToRender",
            "kind": "FrameStream",
            "payload_type": "MainToRenderFrame",
            "from": "MainPU",
            "to": "RenderPU"
        },
        {
            "id": "KernelCanvas",
            "kind": "ServiceStream",
            "payload_type": "ICanvas",
            "from": "MainPU"
        },
        {
            "id": "KernelTextureHandler",
            "kind": "ServiceStream",
            "payload_type": "ITextureHandler",
            "from": "MainPU"
        },
        {
            "id": "KernelMeshHandler",
            "kind": "ServiceStream",
            "payload_type": "Mesh3DAssetHandler",
            "from": "MainPU"
        },
        {
            "id": "AssetLoadStatus",
            "kind": "ServiceStream",
            "payload_type": "AssetLoadStatus",
            "from": "MainPU"
        },
        {
            "id": "AutomationService",
            "kind": "ServiceStream",
            "payload_type": "AutomationService",
            "from": "MainPU"
        },
        {
            "id": "DebugServerService",
            "kind": "ServiceStream",
            "payload_type": "DebugServerService",
            "from": "MainPU"
        },
        {
            "id": "DebugServerPush",
            "kind": "EventStream",
            "payload_type": "DebugServerPushEvent",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "DebugLayerManager",
            "kind": "ServiceStream",
            "payload_type": "DebugLayerManager",
            "from": "SimPU"
        },
        {
            "id": "DomainRegistry",
            "kind": "EventStream",
            "payload_type": "DiaDebugDomainRegistry",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "DebugPanelCommand",
            "kind": "EventStream",
            "payload_type": "DebugPanelCommandEvent",
            "overflow": "drop-oldest",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "DebugPanelToggle",
            "kind": "EventStream",
            "payload_type": "DebugPanelToggleEvent",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "DebugPanelSetVisibility",
            "kind": "EventStream",
            "payload_type": "DebugPanelSetVisibilityEvent",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "RenderToSim",
            "kind": "FrameStream",
            "payload_type": "RenderFence",
            "from": "RenderPU",
            "to": "SimPU"
        },
        {
            "id": "BootMenuNavRequest",
            "kind": "EventStream",
            "payload_type": "RenderToSimNavRequest",
            "overflow": "drop-oldest",
            "from": "RenderPU",
            "to": "SimPU"
        },
        {
            "id": "HUDNavRequest",
            "kind": "EventStream",
            "payload_type": "RenderToSimNavRequest",
            "overflow": "drop-oldest",
            "from": "RenderPU",
            "to": "SimPU"
        }
    ],
    "processing_units": [
        {
            "instance_id": "MainPU",
            "frequency_hz": 30,
            "dedicated_thread": false,
            "modules": [
                {
                    "instance_id": "ObservationModule",
                    "type_id": "ObservationModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "ProfilerModule",
                    "type_id": "ProfilerModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule"
                    ],
                    "channels": []
                },
                {
                    "instance_id": "JobSystemModule",
                    "type_id": "JobSystemModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule"
                    ],
                    "channels": []
                },
                {
                    "instance_id": "KernelModule",
                    "type_id": "KernelModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "JobSystemModule"
                    ],
                    "channels": [
                        {
                            "id": "MainToSim",
                            "role": "writes"
                        },
                        {
                            "id": "KernelCanvas",
                            "role": "provides"
                        },
                        {
                            "id": "KernelTextureHandler",
                            "role": "provides"
                        },
                        {
                            "id": "KernelMeshHandler",
                            "role": "provides"
                        }
                    ]
                },
                {
                    "instance_id": "UIModule",
                    "type_id": "UIModule",
                    "stages": [
                        "Boot",
                        "DummyStage",
                        "UIUltralightTestStage",
                        "RigidBody2DTestStage",
                        "AssetRuntimeTestStage",
                        "Geometry2DTestStage",
                        "EntityTestStage",
                        "SoftBody2DTestStage",
                        "Animation2DTestStage",
                        "Scene2DTestStage",
                        "IK2DTestStage",
                        "Mesh3DTestStage",
                        "Mesh3DRenderSystemTestStage",
                        "AIDecisionTestStage",
                        "AIHTNTestStage",
                        "PathfindingTestStage",
                        "ScalarFieldTestStage",
                        "EntitySpatialTestStage",
                        "EconomyTestStage",
                        "SpawnerTestStage",
                        "ArenaTestStage"
