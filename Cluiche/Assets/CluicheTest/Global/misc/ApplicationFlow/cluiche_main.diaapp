{
    "version": 3,
    "stages": [
        { "name": "Boot",              "transitions": ["DummyStage", "RigidBody2DStage"], "auto_advance": false },
        { "name": "DummyStage",        "transitions": ["Boot"],                          "auto_advance": false },
        { "name": "RigidBody2DStage",  "transitions": ["Boot"],                          "auto_advance": false }
    ],
    "initial_stage": "Boot",
    "streams": [
        {
            "id": "InputToSim",
            "kind": "EventStream",
            "payload_type": "InputEvent",
            "overflow": "drop-oldest",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "SimToRender",
            "kind": "FrameStream",
            "payload_type": "FrameData",
            "from": "SimPU",
            "to": "RenderPU",
            "multi_writer": true
        },
        {
            "id": "SimToUI",
            "kind": "EventStream",
            "payload_type": "UICommand",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "UIToSim",
            "kind": "FrameStream",
            "payload_type": "UIDataBuffer",
            "from": "MainPU",
            "to": "SimPU"
        }
    ],
    "processing_units": [
        {
            "instance_id": "MainPU",
            "frequency_hz": 30,
            "dedicated_thread": false,
            "modules": [
                {
                    "instance_id": "ObservationModule",
                    "type_id": "ObservationModule",
                    "stages": [ "all" ],
                    "dependencies": [],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "ProfilerModule",
                    "type_id": "ProfilerModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule" ],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "JobSystemModule",
                    "type_id": "JobSystemModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule" ],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "KernelModule",
                    "type_id": "KernelModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule", "JobSystemModule" ],
                    "reads": [],
                    "writes": [ "InputToSim" ]
                },
                {
                    "instance_id": "UIModule",
                    "type_id": "UIModule",
                    "stages": [ "DummyStage" ],
                    "dependencies": [ "ObservationModule", "KernelModule" ],
                    "reads": [ "SimToUI" ],
                    "writes": [ "UIToSim" ]
                },
                {
                    "instance_id": "AssetServiceModule",
                    "type_id": "AssetServiceModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule", "KernelModule", "UIModule", "JobSystemModule" ],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "DebugServerHostModule",
                    "type_id": "DebugServerHostModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule" ],
                    "config": {
                        "port": 9002,
                        "auto_start": true,
                        "game_name": "CluicheTest",
                        "game_build": "dev-0.1",
                        "diagame_path": "assets/cluichetest.diagame"
                    },
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "AutomationModule",
                    "type_id": "AutomationModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule", "DebugServerHostModule" ],
                    "reads": [],
                    "writes": []
                }
            ]
        },
        {
            "instance_id": "SimPU",
            "frequency_hz": 30,
            "dedicated_thread": true,
            "modules": [
                {
                    "instance_id": "TimeServerModule",
                    "type_id": "TimeServerModule",
                    "stages": [ "all" ],
                    "dependencies": [],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "InputStreamModule",
                    "type_id": "InputStreamModule",
                    "stages": [ "all" ],
                    "dependencies": [ "TimeServerModule" ],
                    "reads": [ "InputToSim" ],
                    "writes": []
                },
                {
                    "instance_id": "LoadingScreenModule",
                    "type_id": "LoadingScreenModule",
                    "stages": [ "Boot" ],
                    "dependencies": [],
                    "reads": [ "UIToSim" ],
                    "writes": [ "SimToRender" ]
                }
            ]
        },
        {
            "instance_id": "RenderPU",
            "frequency_hz": 60,
            "dedicated_thread": true,
            "modules": [
                {
                    "instance_id": "DebugUI",
                    "type_id": "DebugUIModule",
                    "stages": [ "all" ],
                    "dependencies": [],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "BootMenu",
                    "type_id": "BootMenuModule",
                    "stages": [ "Boot" ],
                    "dependencies": [ "DebugUI" ],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "TestStageHUDModule",
                    "type_id": "TestStageHUDModule",
                    "stages": [ "DummyStage", "RigidBody2DStage" ],
                    "dependencies": [ "DebugUI" ],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "VisualDebuggerConsoleModule",
                    "type_id": "VisualDebuggerConsoleModule",
                    "stages": [ "RigidBody2DStage" ],
                    "dependencies": [ "DebugUI" ],
                    "reads": [],
                    "writes": []
                },
                {
                    "instance_id": "RenderModule",
                    "type_id": "RenderModule",
                    "stages": [ "all" ],
                    "dependencies": [ "DebugUI", "TestStageHUDModule", "VisualDebuggerConsoleModule" ],
                    "reads": [ "SimToRender" ],
                    "writes": []
                }
            ]
        }
    ]
}
