{
    "version": 3,
    "stages": [
        { "name": "Boot",              "transitions": ["DummyStage", "RigidBody2DStage", "AssetRuntimeStage"], "auto_advance": false },
        { "name": "DummyStage",        "transitions": ["Boot"],                          "auto_advance": false },
        { "name": "RigidBody2DStage",  "transitions": ["Boot"],                          "auto_advance": false },
        { "name": "AssetRuntimeStage", "transitions": ["Boot"],                          "auto_advance": false }
    ],
    "initial_stage": "Boot",
    "streams": [
        {
            "id": "MainToSim",
            "kind": "EventStream",
            "payload_type": "MainToSimEvent",
            "overflow": "drop-oldest",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "SimToRender",
            "kind": "FrameStream",
            "payload_type": "FrameData",
            "from": "SimPU",
            "to": "RenderPU",
            "multi_writer": true
        },
        {
            "id": "SimToMain",
            "kind": "EventStream",
            "payload_type": "SimToMainEvent",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "UIToSim",
            "kind": "FrameStream",
            "payload_type": "UIDataBuffer",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "MainToRender",
            "kind": "FrameStream",
            "payload_type": "MainToRenderFrame",
            "from": "MainPU",
            "to": "RenderPU"
        },
        {
            "id": "KernelCanvas",
            "kind": "ServiceStream",
            "payload_type": "ICanvas",
            "from": "MainPU"
        },
        {
            "id": "KernelTextureHandler",
            "kind": "ServiceStream",
            "payload_type": "ITextureHandler",
            "from": "MainPU"
        }
    ],
    "processing_units": [
        {
            "instance_id": "MainPU",
            "frequency_hz": 30,
            "dedicated_thread": false,
            "modules": [
                {
                    "instance_id": "ObservationModule",
                    "type_id": "ObservationModule",
                    "stages": [ "all" ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "ProfilerModule",
                    "type_id": "ProfilerModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule" ],
                    "channels": []
                },
                {
                    "instance_id": "JobSystemModule",
                    "type_id": "JobSystemModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule" ],
                    "channels": []
                },
                {
                    "instance_id": "KernelModule",
                    "type_id": "KernelModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule", "JobSystemModule" ],
                    "channels": [
                        { "id": "MainToSim",           "role": "writes" },
                        { "id": "KernelCanvas",        "role": "provides" },
                        { "id": "KernelTextureHandler", "role": "provides" }
                    ]
                },
                {
                    "instance_id": "UIModule",
                    "type_id": "UIModule",
                    "stages": [ "DummyStage" ],
                    "dependencies": [ "ObservationModule", "KernelModule" ],
                    "channels": [
                        { "id": "SimToMain", "role": "reads" },
                        { "id": "UIToSim",   "role": "writes" }
                    ]
                },
                {
                    "instance_id": "AssetServiceModule",
                    "type_id": "AssetServiceModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule", "KernelModule", "UIModule", "JobSystemModule" ],
                    "channels": [
                        { "id": "KernelTextureHandler", "role": "consumes" }
                    ]
                },
                {
                    "instance_id": "DebugServerHostModule",
                    "type_id": "DebugServerHostModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule" ],
                    "config": {
                        "port": 9002,
                        "auto_start": true,
                        "game_name": "CluicheTest",
                        "game_build": "dev-0.1",
                        "diagame_path": "assets/cluichetest.diagame"
                    },
                    "channels": []
                },
                {
                    "instance_id": "AutomationModule",
                    "type_id": "AutomationModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule", "DebugServerHostModule" ],
                    "channels": []
                },
                {
                    "instance_id": "MainStateProducerModule",
                    "type_id": "MainStateProducerModule",
                    "stages": [ "all" ],
                    "dependencies": [ "ObservationModule", "AutomationModule" ],
                    "channels": [
                        { "id": "MainToRender", "role": "writes" }
                    ]
                }
            ]
        },
        {
            "instance_id": "SimPU",
            "frequency_hz": 30,
            "dedicated_thread": true,
            "modules": [
                {
                    "instance_id": "TimeServerModule",
                    "type_id": "TimeServerModule",
                    "stages": [ "all" ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "InputStreamModule",
                    "type_id": "InputStreamModule",
                    "stages": [ "all" ],
                    "dependencies": [ "TimeServerModule" ],
                    "channels": [
                        { "id": "MainToSim", "role": "reads" }
                    ]
                },
                {
                    "instance_id": "LoadingScreenModule",
                    "type_id": "LoadingScreenModule",
                    "stages": [ "Boot" ],
                    "dependencies": [],
                    "channels": [
                        { "id": "UIToSim",     "role": "reads" },
                        { "id": "SimToRender", "role": "writes" }
                    ]
                }
            ]
        },
        {
            "instance_id": "RenderPU",
            "frequency_hz": 60,
            "dedicated_thread": true,
            "modules": [
                {
                    "instance_id": "DebugUI",
                    "type_id": "DebugUIModule",
                    "stages": [ "all" ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "BootMenu",
                    "type_id": "BootMenuModule",
                    "stages": [ "Boot" ],
                    "dependencies": [ "DebugUI" ],
                    "channels": []
                },
                {
                    "instance_id": "TestStageHUDModule",
                    "type_id": "TestStageHUDModule",
                    "stages": [ "DummyStage", "RigidBody2DStage", "AssetRuntimeStage" ],
                    "dependencies": [ "DebugUI" ],
                    "channels": [
                        { "id": "MainToRender", "role": "reads" }
                    ]
                },
                {
                    "instance_id": "VisualDebuggerConsoleModule",
                    "type_id": "VisualDebuggerConsoleModule",
                    "stages": [ "RigidBody2DStage" ],
                    "dependencies": [ "DebugUI" ],
                    "channels": []
                },
                {
                    "instance_id": "RenderModule",
                    "type_id": "RenderModule",
                    "stages": [ "all" ],
                    "dependencies": [ "DebugUI", "TestStageHUDModule", "VisualDebuggerConsoleModule" ],
                    "channels": [
                        { "id": "SimToRender",        "role": "reads" },
                        { "id": "KernelCanvas",        "role": "consumes" },
                        { "id": "KernelTextureHandler", "role": "consumes" }
                    ]
                }
            ]
        }
    ]
}
