                    "type_id": "TestMainStateProducerModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "AutomationModule",
                        "AssetServiceModule"
                    ],
                    "channels": [
                        {
                            "id": "MainToRender",
                            "role": "writes"
                        }
                    ]
                }
            ]
        },
