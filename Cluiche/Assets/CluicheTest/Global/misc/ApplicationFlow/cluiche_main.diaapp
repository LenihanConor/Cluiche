                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "DebugServerHostModule"
                    ],
                    "channels": [
                        {
                            "id": "AutomationService",
                            "role": "provides"
                        }
                    ]
                },
                {
                    "instance_id": "DebugPanelPageModule",
                    "type_id": "DebugPanelPageModule",
                    "stages": [
                        "RigidBody2DTestStage",
                        "AssetRuntimeTestStage",
                        "Geometry2DTestStage",
                        "EntityTestStage",
                        "SoftBody2DTestStage",
                        "Animation2DTestStage",
                        "Scene2DTestStage",
                        "IK2DTestStage",
                        "Mesh3DTestStage",
                        "Mesh3DRenderSystemTestStage",
                        "AIDecisionTestStage",
                        "AIHTNTestStage",
                        "PathfindingTestStage",
                        "ScalarFieldTestStage",
