                    "channels": [
                        {
                            "id": "DomainRegistry",
                            "role": "reads"
                        },
                        {
                            "id": "DebugPanelCommand",
                            "role": "writes"
                        },
                        {
                            "id": "DebugPanelToggle",
                            "role": "reads"
                        },
                        {
                            "id": "DebugPanelSetVisibility",
                            "role": "reads"
                        }
                    ]
                },
                {
