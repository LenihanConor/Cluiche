{
    "version": 3,
    "stages": [
        {
            "name": "Boot",
            "transitions": [
                "DummyStage",
                "RigidBody2DTestStage",
                "AssetRuntimeTestStage",
                "Geometry2DTestStage",
                "UIUltralightTestStage",
                "EntityTestStage",
                "SoftBody2DTestStage",
                "Animation2DTestStage",
                "Scene2DTestStage",
                "IK2DTestStage",
                "Mesh3DTestStage",
                "Mesh3DRenderSystemTestStage"
            ],
            "auto_advance": false
        },
        {
            "name": "DummyStage",
            "transitions": [],
            "auto_advance": false
        },
        {
            "name": "RigidBody2DTestStage",
            "transitions": [],
            "auto_advance": false
        },
        {
            "name": "AssetRuntimeTestStage",
            "transitions": [],
            "auto_advance": false
        },
        {
            "name": "Geometry2DTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "UIUltralightTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "EntityTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "SoftBody2DTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "Animation2DTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "Scene2DTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "IK2DTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "Mesh3DTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        },
        {
            "name": "Mesh3DRenderSystemTestStage",
            "transitions": [
                "Boot"
            ],
            "auto_advance": false
        }
    ],
    "initial_stage": "Boot",
    "streams": [
        {
            "id": "MainToSim",
            "kind": "EventStream",
            "payload_type": "MainToSimEvent",
            "overflow": "drop-oldest",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "SimToRender",
            "kind": "FrameStream",
            "payload_type": "FrameData",
            "from": "SimPU",
            "to": "RenderPU",
            "multi_writer": true
        },
        {
            "id": "SimToRender3D",
            "kind": "FrameStream",
            "payload_type": "FrameData3D",
            "from": "SimPU",
            "to": "RenderPU",
            "multi_writer": true
        },
        {
            "id": "SimToMain",
            "kind": "EventStream",
            "payload_type": "SimToMainEvent",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "UIToSim",
            "kind": "FrameStream",
            "payload_type": "UIDataBuffer",
            "from": "MainPU",
            "to": "SimPU"
        },
        {
            "id": "MainToRender",
            "kind": "FrameStream",
            "payload_type": "MainToRenderFrame",
            "from": "MainPU",
            "to": "RenderPU"
        },
        {
            "id": "KernelCanvas",
            "kind": "ServiceStream",
            "payload_type": "ICanvas",
            "from": "MainPU"
        },
        {
            "id": "KernelTextureHandler",
            "kind": "ServiceStream",
            "payload_type": "ITextureHandler",
            "from": "MainPU"
        },
        {
            "id": "KernelMeshHandler",
            "kind": "ServiceStream",
            "payload_type": "Mesh3DAssetHandler",
            "from": "MainPU"
        },
        {
            "id": "AssetLoadStatus",
            "kind": "ServiceStream",
            "payload_type": "AssetLoadStatus",
            "from": "MainPU"
        },
        {
            "id": "AutomationService",
            "kind": "ServiceStream",
            "payload_type": "AutomationService",
            "from": "MainPU"
        },
        {
            "id": "DebugServerService",
            "kind": "ServiceStream",
            "payload_type": "DebugServerService",
            "from": "MainPU"
        },
        {
            "id": "EntityInspectPush",
            "kind": "EventStream",
            "payload_type": "EntityInspectEvent",
            "overflow": "drop-oldest",
            "from": "SimPU",
            "to": "MainPU"
        },
        {
            "id": "DebugLayerManager",
            "kind": "ServiceStream",
            "payload_type": "DebugLayerManager",
            "from": "SimPU"
        },
        {
            "id": "RenderToSim",
            "kind": "FrameStream",
            "payload_type": "RenderFence",
            "from": "RenderPU",
            "to": "SimPU"
        }
    ],
    "processing_units": [
        {
            "instance_id": "MainPU",
            "frequency_hz": 30,
            "dedicated_thread": false,
            "modules": [
                {
                    "instance_id": "ObservationModule",
                    "type_id": "ObservationModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "ProfilerModule",
                    "type_id": "ProfilerModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule"
                    ],
                    "channels": []
                },
                {
                    "instance_id": "JobSystemModule",
                    "type_id": "JobSystemModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule"
                    ],
                    "channels": []
                },
                {
                    "instance_id": "KernelModule",
                    "type_id": "KernelModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "JobSystemModule"
                    ],
                    "channels": [
                        {
                            "id": "MainToSim",
                            "role": "writes"
                        },
                        {
                            "id": "KernelCanvas",
                            "role": "provides"
                        },
                        {
                            "id": "KernelTextureHandler",
                            "role": "provides"
                        },
                        {
                            "id": "KernelMeshHandler",
                            "role": "provides"
                        }
                    ]
                },
                {
                    "instance_id": "UIModule",
                    "type_id": "UIModule",
                    "stages": [
                        "DummyStage",
                        "UIUltralightTestStage"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "KernelModule"
                    ],
                    "channels": [
                        {
                            "id": "SimToMain",
                            "role": "reads"
                        },
                        {
                            "id": "UIToSim",
                            "role": "writes"
                        }
                    ]
                },
                {
                    "instance_id": "AssetServiceModule",
                    "type_id": "AssetServiceModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "KernelModule",
                        "UIModule",
                        "JobSystemModule"
                    ],
                    "channels": [
                        {
                            "id": "KernelTextureHandler",
                            "role": "consumes"
                        },
                        {
                            "id": "AssetLoadStatus",
                            "role": "provides"
                        }
                    ]
                },
                {
                    "instance_id": "DebugServerHostModule",
                    "type_id": "DebugServerHostModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule"
                    ],
                    "config": {
                        "port": 9002,
                        "auto_start": true,
                        "diagame_path": "assets/cluichetest.diagame"
                    },
                    "channels": [
                        {
                            "id": "DebugServerService",
                            "role": "provides"
                        },
                        {
                            "id": "EntityInspectPush",
                            "role": "reads"
                        }
                    ]
                },
                {
                    "instance_id": "AutomationModule",
                    "type_id": "AutomationModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "DebugServerHostModule"
                    ],
                    "channels": [
                        {
                            "id": "AutomationService",
                            "role": "provides"
                        }
                    ]
                },
                {
                    "instance_id": "MainStateProducerModule",
                    "type_id": "TestMainStateProducerModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "ObservationModule",
                        "AutomationModule",
                        "AssetServiceModule"
                    ],
                    "channels": [
                        {
                            "id": "MainToRender",
                            "role": "writes"
                        }
                    ]
                }
            ]
        },
        {
            "instance_id": "SimPU",
            "frequency_hz": 30,
            "dedicated_thread": true,
            "modules": [
                {
                    "instance_id": "TimeServerModule",
                    "type_id": "TimeServerModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "InputStreamModule",
                    "type_id": "InputStreamModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "TimeServerModule"
                    ],
                    "channels": [
                        {
                            "id": "MainToSim",
                            "role": "reads"
                        }
                    ]
                },
                {
                    "instance_id": "LoadingScreenModule",
                    "type_id": "LoadingScreenModule",
                    "stages": [
                        "Boot"
                    ],
                    "dependencies": [],
                    "channels": [
                        {
                            "id": "UIToSim",
                            "role": "reads"
                        },
                        {
                            "id": "SimToRender",
                            "role": "writes"
                        }
                    ]
                },
                {
                    "instance_id": "Camera2DModule",
                    "type_id": "Camera2DModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "Light2DModule",
                    "type_id": "Light2DModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "UICompositeModule",
                    "type_id": "UICompositeModule",
                    "stages": [
                        "UIUltralightTestStage"
                    ],
                    "dependencies": [],
                    "channels": [
                        {
                            "id": "UIToSim",
                            "role": "reads"
                        },
                        {
                            "id": "SimToRender",
                            "role": "writes"
                        }
                    ]
                },
                {
                    "instance_id": "PickingModule",
                    "type_id": "PickingModule",
                    "stages": [
                        "RigidBody2DTestStage",
                        "AssetRuntimeTestStage",
                        "Geometry2DTestStage",
                        "EntityTestStage"
                    ],
                    "dependencies": [
                        "InputStreamModule",
                        "Camera2DModule"
                    ],
                    "channels": []
                },
                {
                    "instance_id": "VisualDebuggerModule",
                    "type_id": "VisualDebuggerModule",
                    "stages": [
                        "RigidBody2DTestStage",
                        "AssetRuntimeTestStage",
                        "Geometry2DTestStage",
                        "EntityTestStage",
                        "SoftBody2DTestStage",
                        "Animation2DTestStage",
                        "Scene2DTestStage",
                        "IK2DTestStage",
                        "Mesh3DTestStage",
                        "Mesh3DRenderSystemTestStage"
                    ],
                    "dependencies": [
                        "Camera2DModule"
                    ],
                    "channels": [
                        {
                            "id": "SimToRender",
                            "role": "writes"
                        },
                        {
                            "id": "DebugLayerManager",
                            "role": "provides"
                        }
                    ]
                },
                {
                    "instance_id": "Physics2DModule",
                    "type_id": "Physics2DModule",
                    "stages": [
                        "RigidBody2DTestStage",
                        "SoftBody2DTestStage"
                    ],
                    "dependencies": [
                        "VisualDebuggerModule"
                    ],
                    "channels": []
                }
            ]
        },
        {
            "instance_id": "RenderPU",
            "frequency_hz": 30,
            "dedicated_thread": true,
            "modules": [
                {
                    "instance_id": "DebugUI",
                    "type_id": "DebugUIModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [],
                    "channels": []
                },
                {
                    "instance_id": "BootMenu",
                    "type_id": "BootMenuModule",
                    "stages": [
                        "Boot"
                    ],
                    "dependencies": [
                        "DebugUI"
                    ],
                    "channels": []
                },
                {
                    "instance_id": "TestStageHUDModule",
                    "type_id": "TestStageHUDModule",
                    "stages": [
                        "DummyStage",
                        "RigidBody2DTestStage",
                        "AssetRuntimeTestStage",
                        "Geometry2DTestStage",
                        "UIUltralightTestStage",
                        "EntityTestStage",
                        "SoftBody2DTestStage",
                        "Animation2DTestStage",
                        "Scene2DTestStage",
                        "IK2DTestStage",
                        "Mesh3DTestStage",
                        "Mesh3DRenderSystemTestStage"
                    ],
                    "dependencies": [
                        "DebugUI"
                    ],
                    "channels": [
                        {
                            "id": "MainToRender",
                            "role": "reads"
                        }
                    ]
                },
                {
                    "instance_id": "VisualDebuggerConsoleModule",
                    "type_id": "VisualDebuggerConsoleModule",
                    "stages": [
                        "RigidBody2DTestStage",
                        "AssetRuntimeTestStage",
                        "Geometry2DTestStage",
                        "EntityTestStage",
                        "SoftBody2DTestStage",
                        "Animation2DTestStage",
                        "Scene2DTestStage",
                        "IK2DTestStage",
                        "Mesh3DTestStage",
                        "Mesh3DRenderSystemTestStage"
                    ],
                    "dependencies": [
                        "DebugUI"
                    ],
                    "channels": [
                        {
                            "id": "DebugLayerManager",
                            "role": "consumes"
                        }
                    ]
                },
                {
                    "instance_id": "AssetRuntimeVisualDebuggerModule",
                    "type_id": "AssetRuntimeVisualDebuggerModule",
                    "stages": [
                        "AssetRuntimeTestStage"
                    ],
                    "dependencies": [
                        "DebugUI"
                    ],
                    "channels": [
                        {
                            "id": "DebugLayerManager",
                            "role": "consumes"
                        }
                    ]
                },
                {
                    "instance_id": "AssetRuntimeHUDModule",
                    "type_id": "AssetRuntimeHUDModule",
                    "stages": [
                        "AssetRuntimeTestStage"
                    ],
                    "dependencies": [
                        "DebugUI"
                    ],
                    "channels": [
                        {
                            "id": "MainToRender",
                            "role": "reads"
                        }
                    ]
                },
                {
                    "instance_id": "RenderModule",
                    "type_id": "RenderModule",
                    "stages": [
                        "all"
                    ],
                    "dependencies": [
                        "DebugUI",
                        "TestStageHUDModule",
                        "VisualDebuggerConsoleModule",
                        "AssetRuntimeVisualDebuggerModule",
                        "AssetRuntimeHUDModule"
                    ],
                    "channels": [
                        {
                            "id": "SimToRender",
                            "role": "reads"
                        },
                        {
                            "id": "SimToRender3D",
                            "role": "reads"
                        },
                        {
                            "id": "RenderToSim",
                            "role": "writes"
                        },
                        {
                            "id": "KernelCanvas",
                            "role": "consumes"
                        },
                        {
                            "id": "KernelTextureHandler",
                            "role": "consumes"
                        }
                    ]
                }
            ]
        }
    ]
}