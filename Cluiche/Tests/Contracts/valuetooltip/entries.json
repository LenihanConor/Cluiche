      "for": "cow.ecology_params",
      "entry": {
        "key": "grazing.rate",
        "kind": "parameter",
        "label": "Grazing rate",
        "description": "How much vegetation herbivores eat each season, relative to normal.",
        "hint": "Above 1.5 the herbivores usually outrun their food supply.",
        "unit": "× per season",
        "type": "float",
        "min": 0,
        "max": 2,
        "default": 1.0,
        "affects": ["producers_total", "group.herbivore"],
        "related": ["regrowth.forest"],
        "source": "A1 step 6",
        "ui": { "group": "Herbivory", "step": 0.05, "decimals": 2 }
      },
      "options": { "inspector": false, "packId": null, "resolvable": ["regrowth.forest"] }
