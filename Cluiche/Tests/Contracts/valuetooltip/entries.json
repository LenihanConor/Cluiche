    {
      "id": "long_text",
      "for": "cow.ecology_params",
      "entry": {
        "key": "overgraze.pressure",
        "kind": "parameter",
        "label": "Overgraze pressure",
        "description": "Controls how aggressively herbivore populations strip standing vegetation from a cell during each seasonal update. Values below one let the vegetation recover between seasons; values above one cause overgrazing, which depresses soil fertility, starves the herbivores in the following season, and can collapse the local food chain entirely.",
        "type": "float"
      },
      "options": { "inspector": false, "packId": null, "resolvable": [] }
    }
